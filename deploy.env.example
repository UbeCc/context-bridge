# Context Bridge — deployment environment (EXAMPLE).
#
# Copy this file to `deploy.env`, fill in THIS host's values, then run:
#
#   cp deploy.env.example deploy.env && $EDITOR deploy.env
#   ./scripts/deploy.sh
#
# deploy.env is untracked (see .gitignore) and must NEVER be committed: it holds real
# paths, chat ids and interpreter locations. scripts/deploy.sh sources it as shell, so
# later values may reference earlier ones (CONFIG=$HUB_DIR/config.toml).
#
# Every value below has a safe default in deploy.sh; only HUB_DIR, BOTS and each bot's
# state directory are genuinely required.

# --------------------------------------------------------------------------------------
# Hub (the private, git-backed data repository — keep it on persistent storage)
# --------------------------------------------------------------------------------------
HUB_DIR=/srv/context-hub
CONFIG=$HUB_DIR/config.toml
LOG_DIR=$HUB_DIR/run

# Optional: a private remote for the hub (never a public repository) and whether to
# commit/push automatically. Multi-host sharing requires a private remote.
# HUB_REMOTE=git@example.com:private/context-hub.git
# HUB_AUTO_PUSH=false
# HUB_COMMIT=true

# --------------------------------------------------------------------------------------
# Web console / HTTP API
# --------------------------------------------------------------------------------------
PORT=8080
BIND_HOST=0.0.0.0
# External address people open in a browser. Set the host/port that the firewall forwards.
PUBLIC_URL=http://example.com:8080/
# Health probe used while waiting for the server to come up (default derives from PORT).
# HEALTH_URL=http://localhost:8080/api/health
# HEALTH_TIMEOUT=30
# Optional bearer token for /api/* and the console. Leave empty on a firewalled host.
# SERVER_TOKEN=

# --------------------------------------------------------------------------------------
# Python interpreter
# --------------------------------------------------------------------------------------
# Must have SQLite >= 3.38: agent orchestrator databases use JSON '->>' generated
# columns, which older SQLite builds cannot read. deploy.sh refuses to start otherwise.
CTXBRIDGE_PY=python3
# Use an existing executable instead of `python -m context_bridge.cli` if you have one.
# CTXBRIDGE_BIN=ctxbridge
# Set to 0 on offline hosts to skip the best-effort editable install.
# CTXBRIDGE_INSTALL=auto

# Extra directories prepended to PATH inside the daemons (tmux sessions do not inherit
# your interactive shell's PATH).
# PATH_PREFIX=/opt/tooling/bin

# Extra environment variables exported into both daemon wrappers (space separated).
# Useful for e.g. a zstd binary that is not on PATH:
#   CTXBRIDGE_ZSTD=/opt/tooling/bin/zstd
#   SERVICE_ENV="CTXBRIDGE_ZSTD"
# SERVICE_ENV=

# --------------------------------------------------------------------------------------
# Collector daemon
# --------------------------------------------------------------------------------------
SYNC_INTERVAL=60
# Where the bots' agent session transcripts live (one directory per working directory).
SESSIONS_ROOT=$HOME/.dsh/sessions
# Extra internal domains to mask in addition to private IPs (comma separated).
MASK_INTERNAL_DOMAINS=corp.example.com,intranet.example.com
# Extra redaction regexes for internal hostnames/identifiers (comma separated). A regex may
# itself contain a comma — then separate patterns with a double comma ",," instead.
# Example internal host forms:
# REDACTION_EXTRA_PATTERNS='dev-[0-9]{3,4},,euler-[0-9]+,,[a-z0-9-]+-build-[a-z0-9-]+'
REDACTION_EXTRA_PATTERNS=

# --------------------------------------------------------------------------------------
# Bots: space-separated ids, then BOT_<ID>_* for each one.
# The collector reads <state_dir>/orchestrator.sqlite (read-only). `profile` is the
# agent framework profile name, `label`/`color`/`emoji` are console cosmetics.
# --------------------------------------------------------------------------------------
BOTS="atlas beacon cinder"

BOT_ATLAS_LABEL=Atlas
BOT_ATLAS_PROFILE=superagent
BOT_ATLAS_STATE_DIR=/opt/agent-state/atlas
BOT_ATLAS_COLOR=#7c5cff
BOT_ATLAS_EMOJI=🟣

BOT_BEACON_LABEL=Beacon
BOT_BEACON_PROFILE=superagent-beacon
BOT_BEACON_STATE_DIR=/opt/agent-state/beacon
BOT_BEACON_COLOR=#2fc8b5
BOT_BEACON_EMOJI=🩵

BOT_CINDER_LABEL=Cinder
BOT_CINDER_PROFILE=superagent-cinder
BOT_CINDER_STATE_DIR=/opt/agent-state/cinder
BOT_CINDER_COLOR=#f0a13b
BOT_CINDER_EMOJI=🟠
# Override the shared sessions root for one bot:
# BOT_CINDER_SESSIONS_ROOT=/mnt/other-sessions

# --------------------------------------------------------------------------------------
# Console -> bot command relay through a chat source (optional, disabled by default).
# The bridge sends a chat message that @-mentions the target bot; the bot's own
# intake/authorization rules still apply. Credentials stay in the chat CLI's own login.
# --------------------------------------------------------------------------------------
FEISHU_ENABLED=false
FEISHU_CLI=lark-cli
FEISHU_IDENTITY=atlas
# Chat that the bridge posts to, and where the bots listen (placeholder format oc_...).
# FEISHU_RELAY_CHAT_ID=oc_EXAMPLE
# Per-bot open_id used to build the real @mention (placeholder format ou_...).
# BOT_ATLAS_OPEN_ID=ou_EXAMPLE
# BOT_BEACON_OPEN_ID=ou_EXAMPLE
# BOT_CINDER_OPEN_ID=ou_EXAMPLE

# --------------------------------------------------------------------------------------
# Shared DSH skill for the bots: installed once, read by every agent on this host.
# `symlink` keeps it in sync with the repository; `copy` is for hosts that package the
# repo elsewhere.
# --------------------------------------------------------------------------------------
SKILLS_DIR=$HOME/.agents/skills/context-bridge
SKILL_MODE=symlink
# SKILL_SRC=/opt/context-bridge/integrations/dsh-skill

# --------------------------------------------------------------------------------------
# tmux supervision (one host, no systemd user services by convention)
# --------------------------------------------------------------------------------------
SYNC_SESSION=ctxbridge-sync
SERVE_SESSION=ctxbridge-serve
